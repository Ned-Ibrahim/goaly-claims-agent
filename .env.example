# Copy this file to .env and fill in what you need. .env is git-ignored.
# Lines starting with # are comments. Leave a setting out to use its default.

# --- Run without a key -------------------------------------------------------
# Set to fake to use a deterministic stand-in for the model (no API key, no network).
# Remove or comment out for a live model.
# SOP_LLM=fake

# --- Provider and keys -------------------------------------------------------
# Which model provider to use: anthropic (default) or openai.
# CLAIMS_PROVIDER=anthropic

# Your Anthropic API key. Used when CLAIMS_PROVIDER is anthropic.
# You can also paste a key into the field at the top of the web page instead.
ANTHROPIC_API_KEY=

# Your OpenAI API key. Used when CLAIMS_PROVIDER is openai.
OPENAI_API_KEY=

# Optional base URL for an OpenAI-compatible provider. Only read when CLAIMS_PROVIDER is openai.
# OPENAI_BASE_URL=

# --- Models ------------------------------------------------------------------
# Model for the extract call (reads each caller message into a structured form).
# Default with anthropic: claude-haiku-5-5. Required with openai (no default is guessed).
# CLAIMS_EXTRACT_MODEL=

# Model for the reply call (writes the reply within the limits code sets).
# Default with anthropic: claude-opus-5-5. Required with openai.
# CLAIMS_RESPOND_MODEL=

# Effort level for the reply call (anthropic only): low, medium, high, xhigh or max. Default: medium.
# CLAIMS_EFFORT=medium

# --- Scenario and data -------------------------------------------------------
# Which simulated answer the policyholder gives when a representative asks for consent.
# default: pending, then approved. timeout: stays pending, so nothing is disclosed.
# CLAIMS_CONSENT_SCENARIO=default

# The date deadlines are judged against: YYYY-MM-DD, or "real" for the system clock.
# Default: the day after the newest claim in the sample data (2026-03-02), so the sample deadlines read as open.
# SOP_TODAY=

# Folder holding the sample JSON files. Default: app/data/starter.
# SOP_DATA_DIR=

# --- Privacy and logs --------------------------------------------------------
# Set to 0 to turn off the optional Presidio detector. It only runs if the presidio extra is installed.
# PII_PRESIDIO=1

# Folder for the masked per-call trace files (one .jsonl per session). Default: traces
# CLAIMS_TRACE_DIR=traces

# Set to 1 to print extra controller trace output to the server log.
# SOP_DEBUG_TRACE=0
